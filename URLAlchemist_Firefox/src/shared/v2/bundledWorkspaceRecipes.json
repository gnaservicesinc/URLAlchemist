{
  "kind": "url-alchemist.bundled-workspace-recipes.v1",
  "entries": [
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200001",
      "slug": "clean-share-link",
      "category": "URL cleanup",
      "collection": "bundled",
      "risk": "safe",
      "features": ["Known tracker removal", "Unknown parameters preserved", "Automatic URL cleanup"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Clean Share Link",
        "description": "Removes common campaign-tracking parameters while preserving every unrecognized query parameter, fragment, and signed value.",
        "trigger": {
          "type": "INPUT_DATA",
          "hotkey": "Ctrl+Shift+U",
          "inputSources": ["url"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 120 }, "settings": { "locked": true } },
          { "id": "remove-trackers", "type": "RegExpression", "position": { "x": 300, "y": 80 }, "settings": { "label": "Remove known trackers", "pattern": "([?&])(?:utm_[^=&#?]+|fbclid|gclid|dclid|msclkid|mc_cid|mc_eid|_hsenc|_hsmi)=[^&#]*(?=&|#|$)", "action": "SUBSTITUTE", "matchMode": "STANDARD", "payload": "$1", "payloadVars": true } },
          { "id": "collapse-ampersands", "type": "RegExpression", "position": { "x": 620, "y": 80 }, "settings": { "label": "Collapse duplicate separators", "pattern": "&&+", "action": "SUBSTITUTE", "matchMode": "STANDARD", "payload": "&" } },
          { "id": "tidy-query-start", "type": "RegExpression", "position": { "x": 940, "y": 80 }, "settings": { "label": "Tidy query start", "pattern": "\\?&+", "action": "SUBSTITUTE", "matchMode": "STANDARD", "payload": "?" } },
          { "id": "trim-empty-query", "type": "RegExpression", "position": { "x": 1260, "y": 80 }, "settings": { "label": "Remove empty separators", "pattern": "[?&](?=#|$)", "action": "REMOVE", "matchMode": "STANDARD" } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 1580, "y": 120 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "input.url", "to": "remove-trackers.input" },
          { "from": "remove-trackers.result", "to": "collapse-ampersands.input" },
          { "from": "collapse-ampersands.result", "to": "tidy-query-start.input" },
          { "from": "tidy-query-start.result", "to": "trim-empty-query.input" },
          { "from": "trim-empty-query.result", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.78 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200003",
      "slug": "open-github-pr-files",
      "category": "URL cleanup",
      "collection": "bundled",
      "risk": "safe",
      "features": ["Link context menu", "Strict GitHub PR scope", "Idempotent Files routing"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Open GitHub PR Files",
        "description": "Opens the Files view for a GitHub pull-request link without adding a second /files segment when the link already points there.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+G",
          "inputSources": ["linkUrl"],
          "sourceFilters": [{ "source": "linkUrl", "pattern": "^https://github\\.com/[^/]+/[^/]+/pull/\\d+(?:/(?:files|commits|checks))?/?(?:[?#]|$)" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 120 }, "settings": { "locked": true } },
          { "id": "route-files", "type": "RegExpression", "position": { "x": 320, "y": 80 }, "settings": { "label": "Route to Files", "pattern": "^(https://github\\.com/[^/]+/[^/]+/pull/\\d+)(?:/(?:files|commits|checks))?/?(?=[?#]|$)", "action": "SUBSTITUTE", "matchMode": "STANDARD", "payload": "$1/files", "payloadVars": true } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 660, "y": 120 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "input.linkUrl", "to": "route-files.input" },
          { "from": "route-files.result", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.9 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200004",
      "slug": "search-selected-text",
      "category": "Search",
      "collection": "bundled",
      "risk": "safe",
      "features": ["Selected-text input", "Standards-based URL encoding", "Hotkey search"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Search Selected Text",
        "description": "Trims and safely URL-encodes the current selection, then opens a web search from a hotkey.",
        "trigger": {
          "type": "HOTKEY",
          "hotkey": "Ctrl+Shift+S",
          "inputSources": ["selectedText"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 120 }, "settings": { "locked": true } },
          { "id": "trim", "type": "TextTransform", "position": { "x": 280, "y": 80 }, "settings": { "label": "Trim selection", "textTransformMode": "TRIM" } },
          { "id": "encode", "type": "TextTransform", "position": { "x": 560, "y": 80 }, "settings": { "label": "Encode search query", "textTransformMode": "URL_ENCODE" } },
          { "id": "build-search-url", "type": "Substitution", "position": { "x": 840, "y": 80 }, "settings": { "label": "Build search URL", "substitutionTemplate": "https://www.google.com/search?q=$1", "substitutionInputCount": 1 } },
          { "id": "to-url", "type": "Convert", "position": { "x": 1140, "y": 80 }, "settings": { "label": "Convert to URL", "convertMode": "STRING_TO_URL" } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 1440, "y": 120 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "input.selectedText", "to": "trim.input" },
          { "from": "trim.result", "to": "encode.input" },
          { "from": "encode.result", "to": "build-search-url.value1" },
          { "from": "build-search-url.result", "to": "to-url.input" },
          { "from": "to-url.result", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.82 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200007",
      "slug": "copy-markdown-citation",
      "category": "Page tools",
      "collection": "bundled",
      "risk": "high",
      "features": ["Page title and URL", "Local access date", "Markdown clipboard output"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Copy Markdown Citation",
        "description": "Copies the current page as a tidy Markdown citation containing its title, URL, and local access date.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+C",
          "inputSources": ["url", "pageTitle"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 180 }, "settings": { "locked": true } },
          { "id": "today", "type": "SystemData", "position": { "x": 300, "y": 260 }, "settings": { "label": "Local access date", "systemDataMode": "LOCALE_DATE" } },
          { "id": "format", "type": "Substitution", "position": { "x": 500, "y": 100 }, "settings": { "label": "Format Markdown citation", "substitutionTemplate": "**$1**\n<$2>\nAccessed $3", "substitutionInputCount": 3 } },
          { "id": "clipboard", "type": "ExtendedDataOut", "position": { "x": 980, "y": 80 }, "settings": { "label": "Copy citation" } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 980, "y": 280 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "input.pageTitle", "to": "format.value1" },
          { "from": "input.url", "to": "format.value2" },
          { "from": "today.result", "to": "format.value3" },
          { "from": "format.result", "to": "clipboard.clipboard" },
          { "from": "input.url", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.86 }
      }
    },
    {
      "id": "daf235dc-182c-4df0-b806-9d22f4a0c1c4",
      "slug": "normalize-clipboard-text",
      "category": "Page tools",
      "collection": "bundled",
      "risk": "high",
      "features": ["Clipboard read and write", "Paragraphs preserved", "Control-character cleanup"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Normalize Clipboard Text",
        "description": "Normalizes line endings, removes unsafe control characters, and trims clipboard text while preserving paragraphs and intentional spacing.",
        "trigger": {
          "type": "HOTKEY",
          "hotkey": "Ctrl+Shift+X",
          "inputSources": ["clipboard", "url"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 260 }, "settings": { "locked": true } },
          { "id": "extended-input", "type": "ExtendedDataIn", "position": { "x": 0, "y": 40 }, "settings": { "label": "Read clipboard" } },
          { "id": "normalize-lines", "type": "TextTransform", "position": { "x": 300, "y": 40 }, "settings": { "label": "Normalize line endings", "textTransformMode": "NORMALIZE_LINE_ENDINGS" } },
          { "id": "strip-control", "type": "TextTransform", "position": { "x": 600, "y": 40 }, "settings": { "label": "Strip control characters", "textTransformMode": "STRIP_CONTROL_CHARS" } },
          { "id": "trim", "type": "TextTransform", "position": { "x": 900, "y": 40 }, "settings": { "label": "Trim outer whitespace", "textTransformMode": "TRIM" } },
          { "id": "clipboard", "type": "ExtendedDataOut", "position": { "x": 1200, "y": 40 }, "settings": { "label": "Write clean clipboard" } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 1200, "y": 260 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "extended-input.clipboard", "to": "normalize-lines.input" },
          { "from": "normalize-lines.result", "to": "strip-control.input" },
          { "from": "strip-control.result", "to": "trim.input" },
          { "from": "trim.result", "to": "clipboard.clipboard" },
          { "from": "input.url", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.84 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200006",
      "slug": "research-trail",
      "category": "Storage",
      "collection": "bundled",
      "risk": "extended",
      "features": ["Previous and current page card", "Title and URL history", "Local cross-run state"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Research Trail",
        "description": "Shows a friendly previous-versus-current page card, then remembers the current title and URL for the next run.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+R",
          "inputSources": ["url", "pageTitle"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 240 }, "settings": { "locked": true } },
          { "id": "previous-title", "type": "SharedState", "position": { "x": 280, "y": 20 }, "settings": { "label": "Load previous title", "sharedStateMode": "GET", "literalValue": "research-trail:last-title", "selectFalseValue": "No previous page yet", "literalDataType": "string" } },
          { "id": "previous-url", "type": "SharedState", "position": { "x": 280, "y": 140 }, "settings": { "label": "Load previous URL", "sharedStateMode": "GET", "literalValue": "research-trail:last-url", "selectFalseValue": "Run this again after visiting another page.", "literalDataType": "string" } },
          { "id": "card", "type": "Substitution", "position": { "x": 620, "y": 80 }, "settings": { "label": "Build research card", "substitutionTemplate": "Previous page\n$1\n$2\n\nCurrent page\n$3\n$4", "substitutionInputCount": 4 } },
          { "id": "show-card", "type": "ShowMessage", "position": { "x": 980, "y": 80 }, "settings": { "label": "Show research trail", "promptTitle": "Research Trail", "promptMessage": "Previous and current page", "displayMode": "OVERLAY", "displayTimeoutMs": 10000 } },
          { "id": "save-title", "type": "SharedState", "position": { "x": 620, "y": 300 }, "settings": { "label": "Remember current title", "sharedStateMode": "SET", "literalValue": "research-trail:last-title", "literalDataType": "string", "alwaysProcess": true } },
          { "id": "save-url", "type": "SharedState", "position": { "x": 940, "y": 300 }, "settings": { "label": "Remember current URL", "sharedStateMode": "SET", "literalValue": "research-trail:last-url", "literalDataType": "URL", "alwaysProcess": true } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 1260, "y": 260 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "previous-title.result", "to": "card.value1" },
          { "from": "previous-url.result", "to": "card.value2" },
          { "from": "input.pageTitle", "to": "card.value3" },
          { "from": "input.url", "to": "card.value4" },
          { "from": "card.result", "to": "show-card.message" },
          { "from": "input.pageTitle", "to": "save-title.value" },
          { "from": "input.url", "to": "save-url.value" },
          { "from": "input.url", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.82 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200011",
      "slug": "redact-emails-for-screen-sharing",
      "category": "Page tools",
      "collection": "examples",
      "risk": "high",
      "features": ["Explicit confirmation", "Email-address masking", "Visible page mutation warning"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Redact Emails for Screen Sharing",
        "description": "After explicit confirmation, masks email addresses in visible page text for screen sharing. Reloading restores the original page.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+E",
          "inputSources": ["pageText", "url"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 300 }, "settings": { "locked": true } },
          { "id": "page-text", "type": "ExtendedDataIn", "position": { "x": 0, "y": 60 }, "settings": { "label": "Read visible page text" } },
          { "id": "confirm", "type": "Confirm", "position": { "x": 280, "y": 300 }, "settings": { "label": "Confirm page redaction", "promptMessage": "Mask visible email addresses on this page for screen sharing? This changes page text until the page is reloaded." } },
          { "id": "confirmed-value", "type": "DictGet", "position": { "x": 580, "y": 300 }, "settings": { "label": "Read confirmation", "dictKey": "value", "literalValue": "0", "literalDataType": "bool" } },
          { "id": "confirmed", "type": "Logical", "position": { "x": 860, "y": 280 }, "settings": { "label": "User confirmed", "operator": "EQ", "compareValue": "1", "booleanOutput": true, "locked": true } },
          { "id": "branch", "type": "LogicalFlow", "position": { "x": 1160, "y": 60 }, "settings": { "label": "Confirmed redaction", "locked": true } },
          { "id": "mask-emails", "type": "RegExpression", "position": { "x": 1480, "y": 20 }, "settings": { "label": "Mask email addresses", "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}\\b", "action": "SUBSTITUTE", "matchMode": "STANDARD", "payload": "[email redacted]" } },
          { "id": "mutate-page", "type": "ExtendedDataOut", "position": { "x": 1840, "y": 0 }, "settings": { "label": "Apply redacted page text" } },
          { "id": "success-text", "type": "Substitution", "position": { "x": 1840, "y": 140 }, "settings": { "label": "Build completion message", "substitutionTemplate": "Email addresses are masked for screen sharing. Reload the page to restore its original text.", "substitutionInputCount": 1 } },
          { "id": "success", "type": "ShowMessage", "position": { "x": 2180, "y": 140 }, "settings": { "label": "Show completion", "promptTitle": "Screen-sharing redaction active", "promptMessage": "Email addresses were masked.", "displayMode": "OVERLAY", "displayTimeoutMs": 7000 } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 2180, "y": 340 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "confirm.result", "to": "confirmed-value.dict" },
          { "from": "confirmed-value.result", "to": "confirmed.input" },
          { "from": "page-text.pageText", "to": "branch.input" },
          { "from": "confirmed.result", "to": "branch.condition" },
          { "from": "branch.trueValue", "to": "mask-emails.input" },
          { "from": "mask-emails.result", "to": "mutate-page.pageText" },
          { "from": "mask-emails.result", "to": "success-text.value1" },
          { "from": "success-text.result", "to": "success.message" },
          { "from": "input.url", "to": "output.url" }
        ],
        "logicalFlows": [{ "id": "redaction", "conditionNode": "confirmed", "controlNode": "branch", "depth": 0, "locked": true }],
        "viewport": { "x": 0, "y": 0, "zoom": 0.68 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200009",
      "slug": "fetch-and-preview-text",
      "category": "Remote data",
      "collection": "examples",
      "risk": "high",
      "features": ["Prompted HTTPS endpoint", "Bounded remote GET", "Overlay-only preview"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Fetch and Preview Text",
        "description": "Prompts for a public HTTPS URL, fetches a bounded text response, and previews it in an overlay without changing the page.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+F",
          "inputSources": ["url"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 260 }, "settings": { "locked": true } },
          { "id": "endpoint-prompt", "type": "PromptText", "position": { "x": 0, "y": 40 }, "settings": { "label": "Choose HTTPS endpoint", "promptMessage": "Enter a public HTTPS URL to fetch as text.", "promptPlaceholder": "https://example.com/", "promptDefaultValue": "https://example.com/" } },
          { "id": "endpoint-value", "type": "DictGet", "position": { "x": 300, "y": 40 }, "settings": { "label": "Read endpoint", "dictKey": "value", "literalValue": "", "literalDataType": "string" } },
          { "id": "trim-endpoint", "type": "TextTransform", "position": { "x": 580, "y": 40 }, "settings": { "label": "Trim endpoint", "textTransformMode": "TRIM" } },
          { "id": "endpoint-url", "type": "Convert", "position": { "x": 860, "y": 40 }, "settings": { "label": "Validate URL shape", "convertMode": "STRING_TO_URL" } },
          { "id": "fetch", "type": "FetchData", "position": { "x": 1140, "y": 40 }, "settings": { "label": "Fetch bounded text", "remoteDataType": "string", "remoteTimeoutMs": 5000, "remoteMaxBytes": 32768 } },
          { "id": "preview-text", "type": "Substitution", "position": { "x": 1440, "y": 40 }, "settings": { "label": "Format preview", "substitutionTemplate": "Response from $1\n\n$2", "substitutionInputCount": 2 } },
          { "id": "preview", "type": "ShowMessage", "position": { "x": 1760, "y": 40 }, "settings": { "label": "Preview fetched text", "promptTitle": "Fetched Text Preview", "promptMessage": "Remote response", "displayMode": "OVERLAY", "displayTimeoutMs": 0 } },
          { "id": "output", "type": "DataFlowOut", "position": { "x": 1760, "y": 260 }, "settings": { "locked": true } }
        ],
        "connections": [
          { "from": "endpoint-prompt.result", "to": "endpoint-value.dict" },
          { "from": "endpoint-value.result", "to": "trim-endpoint.input" },
          { "from": "trim-endpoint.result", "to": "endpoint-url.input" },
          { "from": "endpoint-url.result", "to": "fetch.url" },
          { "from": "endpoint-url.result", "to": "preview-text.value1" },
          { "from": "fetch.result", "to": "preview-text.value2" },
          { "from": "preview-text.result", "to": "preview.message" },
          { "from": "input.url", "to": "output.url" }
        ],
        "viewport": { "x": 0, "y": 0, "zoom": 0.72 }
      }
    },
    {
      "id": "0f6b6d50-9d44-4a86-9d0f-80a9e8200010",
      "slug": "confirmed-webhook-test",
      "category": "Remote data",
      "collection": "examples",
      "risk": "high",
      "features": ["Static non-page payload", "Explicit send confirmation", "Guarded remote POST"],
      "recipe": {
        "kind": "workspace-recipe.v1",
        "workspaceType": "data-modifier",
        "name": "Confirmed Webhook Test",
        "description": "Prompts for a public HTTPS webhook, shows exactly what will happen, and sends only a static sample payload after confirmation.",
        "trigger": {
          "type": "CONTEXT_MENU",
          "hotkey": "Ctrl+Shift+W",
          "inputSources": ["url"],
          "sourceFilters": [{ "source": "url", "pattern": "^https?://" }]
        },
        "nodes": [
          { "id": "input", "type": "DataFlowIn", "position": { "x": 0, "y": 420 }, "settings": { "locked": true } },
          { "id": "endpoint-prompt", "type": "PromptText", "position": { "x": 0, "y": 40 }, "settings": { "label": "Choose webhook endpoint", "promptMessage": "Enter a public HTTPS webhook endpoint for a static test request.", "promptPlaceholder": "https://httpbin.org/post", "promptDefaultValue": "https://httpbin.org/post" } },
          { "id": "endpoint-value", "type": "DictGet", "position": { "x": 300, "y": 40 }, "settings": { "label": "Read endpoint", "dictKey": "value", "literalValue": "", "literalDataType": "string" } },
          { "id": "trim-endpoint", "type": "TextTransform", "position": { "x": 580, "y": 40 }, "settings": { "label": "Trim endpoint", "textTransformMode": "TRIM" } },
          { "id": "endpoint-url", "type": "Convert", "position": { "x": 860, "y": 40 }, "settings": { "label": "Validate URL shape", "convertMode": "STRING_TO_URL" } },
          { "id": "confirm", "type": "Confirm", "position": { "x": 580, "y": 240 }, "settings": { "label": "Confirm test request", "promptMessage": "Send the static sample payload {source: URL Alchemist example, message: Confirmed webhook test}? The current page URL, title, and content are not included." } },
          { "id": "confirmed-value", "type": "DictGet", "position": { "x": 880, "y": 240 }, "settings": { "label": "Read confirmation", "dictKey": "value", "literalValue": "0", "literalDataType": "bool" } },
          { "id": "confirmed", "type": "Logical", "position": { "x": 1160, "y": 220 }, "settings": { "label": "User confirmed", "operator": "EQ", "compareValue": "1", "booleanOutput": true, "locked": true } },
          { "id": "branch", "type": "LogicalFlow", "position": { "x": 1460, "y": 40 }, "settings": { "label": "Confirmed send", "locked": true } },
